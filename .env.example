# Core ports
WEB_PORT=3000
API_PORT=4000
RESEARCH_PORT=8000
LLAMA_PORT=8080

# Prefer IPv4 first because some external data APIs expose slow or unreachable IPv6 routes.
NODE_OPTIONS=--dns-result-order=ipv4first

# Database / queue / storage
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=stock_research
DATABASE_URL=postgres://research:research@postgres:5432/stock_research
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
S3_ENDPOINT=http://minio:9000
S3_BUCKET=research-artifacts

# llama.cpp CUDA server
# Put a GGUF model directly under ./models and set this to its file name.
LLAMA_MODEL=Qwen3.6-35B-A3B-UD-IQ4_NL_XL.gguf
LLAMA_CONTEXT_SIZE=16384
LLAMA_N_GPU_LAYERS=99
LLAMA_PARALLEL=1
LLAMA_BASE_URL=http://llama:8080/v1
LLAMA_MODEL_NAME=local-gguf
LLAMA_REQUEST_TIMEOUT=900
RESEARCH_TIMEOUT_MS=900000

# Keep false in normal use so missing llama.cpp/model issues are visible.
ALLOW_LLM_FALLBACK=false

# J-Quants real data source
# V2 uses a dashboard API key. Legacy V1 ID/refresh-token settings are kept for migration.
JQUANTS_BASE_URL=https://api.jquants.com/v2
JQUANTS_API_KEY=
# Alias accepted by this app for the API Token shown in quick starts.
JQUANTS_API_TOKEN=
JQUANTS_ID_TOKEN=
JQUANTS_REFRESH_TOKEN=
JQUANTS_EMAIL=
JQUANTS_PASSWORD=

# Optional macro data sources.
# Format: symbol:label,symbol:label
MACRO_INDEX_SYMBOLS=
# Format: https://example.com/feed.xml|Source Name|perspective,https://example.com/feed2.xml|Source Name|perspective
OFFICIAL_NEWS_RSS_URLS=
TRUSTED_NEWS_RSS_URLS=
# Backward-compatible alias for trusted news feeds.
MACRO_NEWS_RSS_URLS=
NEWS_LOOKBACK_DAYS=450
NEWS_MAX_RECORDS=320
COMPANY_NEWS_MAX_RECORDS=260
MACRO_NEWS_MAX_RECORDS=360
NEWS_GDELT_MIN_INTERVAL_MS=7000
# Optional GDELT query override for macro news. Article published time, not retrieval time, is saved.
MACRO_NEWS_QUERY=

# Existing early-MVP fixture rows are removed on API startup by default.
PURGE_SAMPLE_DATA_ON_START=true
